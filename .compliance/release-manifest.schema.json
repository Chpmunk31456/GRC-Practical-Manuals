{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Chpmunk31456/GRC-Practical-Manuals/blob/main/.compliance/release-manifest.schema.json",
  "title": "GRC Practical Manuals release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manual_id",
    "manual_number",
    "title",
    "version",
    "release_status",
    "languages",
    "repository",
    "source_branch",
    "release_commit_sha",
    "source_verification_date",
    "authoritative_source_evidence",
    "translation_status",
    "editorial_status",
    "human_approval",
    "qa",
    "artifacts",
    "github_release",
    "zenodo",
    "release_date",
    "known_exceptions",
    "supersedes",
    "superseded_by"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "manual_id": { "type": "string", "minLength": 1 },
    "manual_number": { "type": "integer", "minimum": 0 },
    "title": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "release_status": { "type": "string", "minLength": 1 },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" }
    },
    "repository": { "const": "Chpmunk31456/GRC-Practical-Manuals" },
    "source_branch": { "type": "string", "minLength": 1 },
    "release_commit_sha": { "$ref": "#/$defs/gitSha" },
    "source_verification_date": { "$ref": "#/$defs/date" },
    "authoritative_source_evidence": { "$ref": "#/$defs/nullableReference" },
    "translation_status": { "$ref": "#/$defs/localeStatusMap" },
    "editorial_status": { "$ref": "#/$defs/localeStatusMap" },
    "human_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/nullableReference" }
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visual", "accessibility", "repository_security", "page_by_page", "trilingual_parity"],
      "properties": {
        "visual": { "type": "string", "minLength": 1 },
        "accessibility": { "type": "string", "minLength": 1 },
        "repository_security": { "type": "string", "minLength": 1 },
        "page_by_page": { "type": "string", "minLength": 1 },
        "trilingual_parity": { "type": "string", "minLength": 1 }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "github_release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "url"],
      "properties": {
        "tag": { "type": ["string", "null"] },
        "url": { "type": ["string", "null"], "format": "uri" }
      }
    },
    "zenodo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept_doi", "version_doi", "record_url"],
      "properties": {
        "concept_doi": { "type": ["string", "null"] },
        "version_doi": { "type": ["string", "null"] },
        "record_url": { "type": ["string", "null"], "format": "uri" }
      }
    },
    "release_date": {
      "oneOf": [
        { "$ref": "#/$defs/date" },
        { "type": "null" }
      ]
    },
    "known_exceptions": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          { "type": "object", "minProperties": 1 }
        ]
      }
    },
    "supersedes": { "type": ["string", "null"] },
    "superseded_by": { "type": ["string", "null"] }
  },
  "$defs": {
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "date": { "type": "string", "format": "date" },
    "nullableReference": { "type": ["string", "null"] },
    "localeStatusMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "language",
        "format",
        "source_commit",
        "generated_date",
        "generation_tool",
        "bytes",
        "sha256",
        "accessibility_status",
        "visual_qa_status"
      ],
      "properties": {
        "filename": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" },
        "format": { "type": "string", "minLength": 1 },
        "source_commit": { "$ref": "#/$defs/gitSha" },
        "generated_date": { "$ref": "#/$defs/date" },
        "generation_tool": { "type": ["string", "null"] },
        "bytes": { "type": ["integer", "null"], "minimum": 0 },
        "sha256": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            { "type": "null" }
          ]
        },
        "accessibility_status": { "type": "string", "minLength": 1 },
        "visual_qa_status": { "type": "string", "minLength": 1 }
      }
    }
  }
}
